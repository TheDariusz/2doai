<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.thedariusz</groupId>
	<artifactId>todoai</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<spring-ai.version>2.0.1</spring-ai.version>
		<!-- REST Assured is not managed by the Spring Boot 4 BOM. 6.x targets Hamcrest 3 / Groovy 4 /
		     Java 17+ — aligned with Boot 4's stack (5.x is built for Hamcrest 2). -->
		<rest-assured.version>6.0.1</rest-assured.version>
		<archunit.version>1.5.0</archunit.version>
		<!-- Patch-level overrides of BOM-managed versions, ahead of the Boot 4.0.x release that
		     picks them up. Both clear fixable HIGH/CRITICAL findings that the CI Trivy gate fails
		     on; drop each override once the Boot parent manages an equal-or-newer version.
		     netty is compile-scope via spring-ai-starter-model-openai (the OpenRouter client),
		     so these are reachable, not test-only. -->
		<netty.version>4.2.16.Final</netty.version>
		<postgresql.version>42.7.12</postgresql.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Spring AI 2.0.0 GA — requires Spring Boot 4.0 (Spring Framework 7,
			     Jackson 3). Manages spring-ai-* versions; the OpenAI starter below
			     drives the OpenRouter (OpenAI-compatible) gateway. -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- LLM gateway: OpenRouter via Spring AI's OpenAI-compatible client.
		     Provider-neutral behind the LlmClient port. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Spring Security 6: cookie-session auth (S-01), BCrypt password encoding, CSRF.
		     The decided session model is a server-side HttpSession cookie, in-memory on the
		     single Fly machine — not JWT (see context/foundation/auth-session-model.md).
		     Version managed by the Spring Boot 4 parent. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Apache Commons Lang — battle-tested helpers (StringUtils, etc.) preferred over
		     hand-rolled null/blank/collection checks. Version managed by the Spring Boot 4 parent. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<!-- Bean Validation (Hibernate Validator) — drives @Validated @ConfigurationProperties
		     so a blank model slug or non-positive render cap fails fast at startup, not on first use. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- SMTP transport behind the EmailSender port (S-05, FR-018) — how the app comes back to a
		     user who is not looking at it. Deliberately plain SMTP rather than a provider SDK: Resend
		     speaks it, so the provider stays a credentials choice and this line adds no new supply
		     chain (Jakarta Mail is BOM-managed, like everything else here). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Data layer: JPA/Hibernate, Postgres driver, Flyway migrations.
		     Versions managed by the Spring Boot 4 parent. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Boot 4 split autoconfigure into per-integration modules:
		     spring-boot-flyway carries FlywayAutoConfiguration and runs migrations
		     before Hibernate validation. flyway-core alone gives the library but
		     no Spring wiring, so migrations never run. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Dev-only: auto-manages the local compose.yaml Postgres for `mvn spring-boot:run`.
		     Skips itself in tests (spring.docker.compose.skip.in-tests=true). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- REST Assured — HTTP-layer / endpoint integration tests against a random-port embedded
		     server, exercising the real Spring Security filter chain end-to-end. The project's
		     standard for endpoint tests (preferred over MockMvc). Version pinned via the
		     rest-assured.version property (not managed by the Boot 4 BOM — see the property comment). -->
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<version>${rest-assured.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Integration tests boot the full context against a real Postgres.
		     Testcontainers BOM is managed by the Spring Boot 4 parent. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ArchUnit — structural convention guards that derive their subjects from the code rather
		     than enumerating them by hand. Promoted in S-02, when the second per-user aggregate made
		     the hand-rolled N = 1 UserOwned check untenable (see UserOwnedConventionTest). The core
		     artifact, not archunit-junit5: the rules run from a plain @Test via ClassFileImporter, so
		     the JUnit engine extension (@AnalyzeClasses / @ArchTest) would be dead weight. Not managed
		     by the Boot 4 BOM, hence the explicit version. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
