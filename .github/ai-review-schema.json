          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "category": { "enum": ["security", "correctness", "perf", "style", "test"] },
          "title": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    }
  }
}
